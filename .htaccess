RewriteEngine On

# Send every request to the secure canonical domain.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.baruchcaterers\.com$ [NC]
RewriteRule ^ https://www.baruchcaterers.com%{REQUEST_URI} [R=301,L]

# Keep text assets served with the expected content types.
AddType text/css .css
AddType application/javascript .js

